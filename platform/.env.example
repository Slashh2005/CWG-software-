# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Where each value comes from is explained in SETUP.md.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase -> Project Settings -> API keys -> service_role.
# Server-side only. Bypasses row level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend -> API Keys
RESEND_API_KEY=
# Address notification emails are sent from (must be on a verified domain)
NOTIFY_FROM="CWG Loads <loads@cwgholdings.net>"
# Where new registrations and booking requests are announced
NOTIFY_ADMIN=
